[node name="BodyLabel" type="Label" parent="UI/HelpScreen/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/font_size = 18
text = "拠点（クリスタル）を守り、全ステージを守り切れば勝利。

・下のボタンでタワーか戦士を選ぶ → 盤面をクリックで設置
・タワーを選ぶと、置く前にマス上へ射程の輪が出る
・右クリック / Esc で選択解除
・戦士は前へ出て敵を足止めする。倒すのはタワーの仕事
・「次の波へ」を押すまで、待ち時間の間に建て直せる

⚠ 重要: タワーはステージが変わるとすべて無くなる。
インターバル画面の強化は種類そのものが強くなる投資だが、
次のステージで置き直すぶんのゴールドも残しておくこと。"
horizontal_alignment = 1
autowrap_mode = 2

